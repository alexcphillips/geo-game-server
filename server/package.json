{
    "name": "@geo/server",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "main": "src/index.ts",
    "imports": {
        "#geo/models": "./src/content/models.ts"
    },
    "scripts": {
        "data:index": "tsx src/dev/geo-data-index.ts",
        "dev": "npm run data:index && tsx watch --include \"src/data/**/*.ts\" --env-file-if-exists ../.env src/index.ts",
        "start": "npm run data:index && tsx --env-file-if-exists ../.env src/index.ts",
        "typecheck": "tsc -p tsconfig.json",
        "test": "node --import tsx --test \"src/**/*.test.ts\"",
        "wipe:geo": "tsx --env-file-if-exists ../.env src/dev/geo-wipe.ts",
        "smoke:geo": "tsx --env-file-if-exists ../.env src/dev/geo-smoke.ts",
        "smoke:geo-suggestions": "tsx --env-file-if-exists ../.env src/dev/geo-suggestions-smoke.ts",
        "smoke:geo-places": "tsx --env-file-if-exists ../.env src/dev/geo-places-smoke.ts",
        "smoke:geo-economy": "tsx --env-file-if-exists ../.env src/dev/geo-economy-smoke.ts",
        "smoke:geo-crafting": "tsx --env-file-if-exists ../.env src/dev/geo-crafting-smoke.ts",
        "smoke:geo-chests": "tsx --env-file-if-exists ../.env src/dev/geo-chests-smoke.ts",
        "smoke:geo-pets": "tsx --env-file-if-exists ../.env src/dev/geo-pets-smoke.ts",
        "smoke:geo-friends": "tsx --env-file-if-exists ../.env src/dev/geo-friends-smoke.ts",
        "smoke:geo-fishing": "tsx --env-file-if-exists ../.env src/dev/geo-fishing-smoke.ts",
        "smoke:geo-farming": "tsx --env-file-if-exists ../.env src/dev/geo-farming-smoke.ts",
        "smoke:geo-bank": "tsx --env-file-if-exists ../.env src/dev/geo-bank-smoke.ts",
        "smoke:geo-wardrobe": "tsx --env-file-if-exists ../.env src/dev/geo-wardrobe-smoke.ts",
        "smoke:geo-inbox": "tsx --env-file-if-exists ../.env src/dev/geo-inbox-smoke.ts",
        "smoke:geo-quests": "tsx --env-file-if-exists ../.env src/dev/geo-quests-smoke.ts",
        "smoke:geo-dungeons": "tsx --env-file-if-exists ../.env src/dev/geo-dungeons-smoke.ts",
        "geo:admin": "tsx --env-file-if-exists ../.env src/dev/geo-make-admin.ts",
        "geo:sell-values": "tsx src/dev/geo-sell-values.ts",
        "geo:data": "tsx src/dev/geo-data.ts"
    },
    "dependencies": {
        "@geo/shared": "*",
        "cors": "^2.8.6",
        "express": "^5.2.1",
        "jsonwebtoken": "^9.0.3",
        "pg": "^8.21.0",
        "ws": "^8.21.0",
        "zod": "^4.6.6"
    },
    "devDependencies": {
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^24.10.1",
        "@types/pg": "^8.20.0",
        "@types/ws": "^8.18.2",
        "tsx": "^4.22.3",
        "typescript": "~5.9.3"
    }
}
