# Read by server/src/config/env.ts.
PORT=3001
NODE_ENV=development

DB_USER=postgres
DB_HOST=localhost
DB_NAME=cozy_apps
DB_PASSWORD="super-secret-password"
DB_PORT=5432

# Required. Signs tokens and seeds spawns; changing it signs everyone out and reshuffles spawns.
GEO_JWT_SECRET=super-secret-geo

# The Worker's GEO_OPS_SECRET (wrangler secret put GEO_OPS_SECRET), for dev scripts run with --url.
GEO_OPS_SECRET=

# Comma-separated browser origins allowed to call the API. The app is native and needs none.
CORS_ORIGINS=
