{
    "name": "geo-game-server",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "workspaces": [
        "shared",
        "server",
        "worker"
    ],
    "scripts": {
        "dev": "npm run dev --workspace @geo/server",
        "start": "npm run start --workspace @geo/server",
        "typecheck": "npm run typecheck --workspaces",
        "lint": "eslint .",
        "test": "npm run test --workspace @geo/server && npm run test --workspace @geo/worker",
        "check": "npm run data:index --workspace @geo/server -- --check && npm run typecheck && npm run lint && npm test && npm run geo:data --workspace @geo/server",
        "dev:worker": "npm run dev --workspace @geo/worker",
        "deploy:worker": "npm run deploy --workspace @geo/worker"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.1",
        "eslint": "^9.39.1",
        "globals": "^16.5.0",
        "typescript": "~5.9.3",
        "typescript-eslint": "^8.48.0"
    }
}
