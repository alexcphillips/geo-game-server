        "smoke:geo-crafting": "tsx --env-file-if-exists ../.env scripts/geo-crafting-smoke.ts",
        "smoke:geo-chests": "tsx --env-file-if-exists ../.env scripts/geo-chests-smoke.ts",
        "smoke:geo-pets": "tsx --env-file-if-exists ../.env scripts/geo-pets-smoke.ts",
        "smoke:geo-friends": "tsx --env-file-if-exists ../.env scripts/geo-friends-smoke.ts",
        "smoke:geo-fishing": "tsx --env-file-if-exists ../.env scripts/geo-fishing-smoke.ts",
